# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings -> Environment Variables
# and mark secrets as "Sensitive".

# --- HitPay environment -----------------------------------------------------
# "sandbox" (default) or "production". Sandbox and production are separate
# HitPay accounts with separate OAuth apps, tokens and API keys.
HITPAY_ENV=sandbox

# --- Merchant/admin sign-in (OAuth app from HitPay Dashboard -> Developers -> App Builder)
HITPAY_CLIENT_ID=your-hitpay-oauth-client-id
HITPAY_CLIENT_SECRET=your-hitpay-oauth-client-secret
# Optional. Defaults to ${NEXT_PUBLIC_SITE_URL}/api/auth/hitpay/callback.
# Must exactly match a Redirect URI registered on the OAuth app.
HITPAY_OAUTH_REDIRECT_URI=

# Encrypts the admin session cookie. At least 32 random characters,
# e.g. the output of: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. Comma-separated HitPay business IDs allowed to sign in at /admin.
# Leave empty to allow any HitPay business owner/admin.
ADMIN_ALLOWED_BUSINESS_IDS=

# --- Storefront credential (server-side only, never sent to browsers) ------
# Set ONE of these. Without either, the store shows demo products and
# checkout is disabled.
#
# OAuth access token copied from /admin after connecting the merchant account.
HITPAY_ACCESS_TOKEN=
# Or a HitPay business API key (Dashboard -> Settings -> API Keys).
HITPAY_API_KEY=

# Optional. Where HitPay should POST payment notifications for each checkout.
HITPAY_WEBHOOK_URL=

# --- Site ---------------------------------------------------------------------
# Public URL of the store, without a trailing slash. Used for canonical URLs,
# the sitemap and OAuth/checkout redirects. On Vercel this falls back to the
# deployment URL when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "auto" (default): use HitPay when a storefront credential is set, else demo.
# "hitpay" or "demo" to force a source.
CATALOG_SOURCE=auto

# Outside Vercel, set to "false" to stop search engines indexing the site.
# On Vercel, only the production deployment is indexable.
ALLOW_INDEXING=true

# --- Development only ---------------------------------------------------------
# Point the app at a local mock (npm run mock:hitpay) instead of HitPay.
HITPAY_API_BASE_URL=
HITPAY_DASHBOARD_URL=
